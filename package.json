{
  "name": "rocketlauncher",
  "private": true,
  "version": "0.1.8",
  "description": "Launcher e indicizzatore di file per Windows",
  "license": "GPL-3.0-only",
  "author": "Leonardo Stagliano",
  "contributors": [
    "Yashvardhan Gupta (Velocmd)"
  ],
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build:win": "tauri build --bundles nsis,msi",
    "test": "node --test \"scripts/*.test.mjs\" \"tests/*.test.mjs\"",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "release:plan": "node scripts/windows-release.mjs plan",
    "smoke:win": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
