{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RocketLauncher",
  "mainBinaryName": "RocketLauncher",
  "version": "../package.json",
  "identifier": "it.stagliano.rocketlauncher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RocketLauncher",
        "label": "main",
        "url": "index.html",
        "width": 800,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "Leonardo Stagliano",
    "copyright": "Copyright © Yashvardhan Gupta (Velocmd), © 2026 Leonardo Stagliano (RocketLauncher). GPL-3.0.",
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "homepage": "https://github.com/leonardostagliano/RocketLauncher",
    "icon": [
      "icons/icon.svg",
      "icons/icon.ico",
      "icons/icon_32x32.png",
      "icons/icon_64x64.png",
      "icons/icon_128x128.png",
      "icons/icon_256x256.png",
      "icons/icon_1024x1024.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": {
          "it-IT": {
            "localePath": "wix/it-IT.wxl"
          }
        },
        "upgradeCode": "3852b432-3d21-5f51-a237-7dc0d6f152e6"
      }
    }
  },
  "plugins": {
    "single-instance": null,
    "autostart": null,
    "opener": null,
    "global-shortcut": null
  }
}